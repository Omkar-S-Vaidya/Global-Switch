# Copy to .env and fill in real values.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
AUTH_SECRET="generate-with: openssl rand -hex 32"

# Optional: free key from https://developer.adzuna.com — enables the Adzuna
# live-jobs source. Leave blank to run on Greenhouse boards only.
ADZUNA_APP_ID=""
ADZUNA_APP_KEY=""

# Optional country-specific sources (leave blank to disable):
# US — USAJOBS (https://developer.usajobs.gov/apirequest/index)
USAJOBS_EMAIL=""
USAJOBS_API_KEY=""
# UK — Reed.co.uk (https://www.reed.co.uk/developers)
REED_API_KEY=""
# Jooble — fills UAE & Japan (free key: https://jooble.org/api/about)
JOOBLE_API_KEY=""
